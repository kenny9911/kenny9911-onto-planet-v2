# Copy configuration selectively; do not commit populated credentials.
DATABASE_URL=postgres://onto_app:CHANGE_ME@localhost:5432/onto_planet
TEST_DATABASE_URL=postgres://onto_test:CHANGE_ME@localhost:5432/onto_planet_test
APP_ORIGIN=http://localhost:4100
HOST=127.0.0.1
PORT=4100
EMBED_WORKER=true
MODEL_PROVIDER=sandbox
# For a live model, select openai or openai-compatible and configure both server and reviewed agent pins.
# MODEL_ID=
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
OPERATOR_ALLOWED_ORIGINS=http://127.0.0.1:4200
# Explicit intranet HTTPS origins must also appear in OPERATOR_ALLOWED_ORIGINS.
# OPERATOR_ALLOWED_PRIVATE_ORIGINS=https://erp.internal.example
SOURCE_SANDBOX_URL=http://127.0.0.1:4200
SOURCE_SANDBOX_TOKEN=CHANGE_ME
